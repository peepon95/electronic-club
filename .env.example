# Paste the normal Share link for each Google Doc.
# In Google Docs, set General access to "Anyone with the link" and Viewer.
VITE_CYBERDECK_PART_1_GUIDE_URL=https://docs.google.com/document/d/YOUR_PART_1_DOC_ID/edit
VITE_CYBERDECK_PART_2_GUIDE_URL=https://docs.google.com/document/d/YOUR_PART_2_DOC_ID/edit

# Supabase stores guide email signups in the guide_signups table.
# Use the public Project URL and publishable key. Never use a secret/service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
